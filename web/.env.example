# Copy to .env.local. Same credentials as the docker-compose MongoDB (../.env.example)
MONGODB_URI=mongodb://panoloc:panoloc@localhost:27017/?authSource=admin
MONGODB_DB=panoloc
MONGODB_COLLECTION=pictures
# The signs of `make push-signs` (its SIGNS_URI): default MONGODB_URI, panoloc, signs
# SIGNS_URI=
# SIGNS_DB=panoloc
# SIGNS_COLLECTION=signs
